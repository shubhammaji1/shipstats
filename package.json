{
  "name": "shipstats-analytics",
  "displayName": "ShipStats — Developer Analytics",
  "description": "Discover npm packages, choose what to track, and see real download trends alongside extension and Reddit counts.",
  "version": "0.3.0",
  "publisher": "shipstats-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhammaji1/shipstats.git"
  },
  "homepage": "https://github.com/shubhammaji1/shipstats#readme",
  "bugs": {
    "url": "https://github.com/shubhammaji1/shipstats/issues"
  },
  "icon": "media/shipstats-icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "npm",
    "analytics",
    "downloads",
    "openvsx",
    "reddit"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onView:shipstats.products"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "shipstats.open",
        "title": "ShipStats: Open Dashboard"
      },
      {
        "command": "shipstats.discover",
        "title": "ShipStats: Discover npm Packages"
      },
      {
        "command": "shipstats.add",
        "title": "ShipStats: Add Product"
      },
      {
        "command": "shipstats.refresh",
        "title": "ShipStats: Refresh Analytics"
      },
      {
        "command": "shipstats.redditToken",
        "title": "ShipStats: Set Reddit Access Token"
      },
      {
        "command": "shipstats.clearRedditToken",
        "title": "ShipStats: Clear Reddit Access Token"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shipstats",
          "title": "ShipStats",
          "icon": "media/shipstats.svg"
        }
      ]
    },
    "views": {
      "shipstats": [
        {
          "id": "shipstats.products",
          "name": "Tracked products"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "shipstats.open",
          "when": "view == shipstats.products",
          "group": "navigation"
        },
        {
          "command": "shipstats.add",
          "when": "view == shipstats.products",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ShipStats",
      "properties": {
        "shipstats.npmUsername": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Public npm maintainer username. Search results are not proof of ownership; private packages are excluded."
        },
        "shipstats.npmScope": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Public npm namespace, with or without @. When set, takes precedence over username; namespace membership does not prove ownership."
        },
        "shipstats.refreshMinutes": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1440,
          "scope": "application",
          "description": "Refresh while the dashboard is open. 0 = manual; positive values use a minimum of 5 minutes. npm data is cached for 10 minutes."
        },
        "shipstats.redditUserAgent": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Required for optional Reddit access: a descriptive User-Agent including app/version and your Reddit username. Requires approved API access."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "check:scripts": "node --check media/dashboard.js && node --check scripts/host-smoke.cjs && node --check scripts/live-smoke.cjs",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "test:live": "npm run compile && node scripts/live-smoke.cjs",
    "test:host": "npm run compile && node scripts/host-smoke.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links -o shipstats-analytics-0.3.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.99.0",
    "@vscode/vsce": "^3.6.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0"
  }
}
